{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!out", "!**/node_modules"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error", "noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } } },
      "style": { "useImportType": "error", "noNonNullAssertion": "error" },
      "complexity": { "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 20 } } }
    }
  },
  "overrides": [{ "includes": ["scripts/**", "fixtures/**"], "linter": { "rules": { "suspicious": { "noConsole": "off" } } } }]
}
