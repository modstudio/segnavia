{
  "name": "segnavia",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "git config core.hooksPath .githooks",
    "build": "bun scripts/build.ts",
    "check": "bun --conditions=@segnavia/source scripts/check.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun --conditions=@segnavia/source test packages scripts",
    "typecheck": "tsc --noEmit -p .",
    "demo": "bun --conditions=@segnavia/source scripts/build-demo.ts && bun --conditions=@segnavia/source scripts/verify-demo.ts && bun --conditions=@segnavia/source scripts/verify-render.ts && node --conditions=@segnavia/source --experimental-strip-types --no-warnings scripts/verify-render.ts && php fixtures/php-host/validate.php out",
    "fidelity": "bun --conditions=@segnavia/source scripts/fidelity/run.ts",
    "fidelity:compare": "bun --conditions=@segnavia/source scripts/fidelity/compare.ts",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun scripts/publish.ts",
    "review:log": "bun scripts/review-log.ts",
    "setup:php": "composer install --working-dir=fixtures/php-host --no-interaction"
  },
  "dependencies": {
    "playwright-core": "1.55.1",
    "zod": "^4.1.0",
    "@segnavia/format": "workspace:*",
    "@segnavia/capture": "workspace:*",
    "@segnavia/diagrams": "workspace:*",
    "@segnavia/markdown-editor": "workspace:*",
    "@segnavia/voice": "workspace:*",
    "@segnavia/render": "workspace:*",
    "@segnavia/frame": "workspace:*",
    "@segnavia/html": "workspace:*",
    "@segnavia/idml": "workspace:*",
    "@segnavia/react": "workspace:*",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2",
    "@changesets/cli": "^2.29.7",
    "@changesets/get-release-plan": "^4.0.16",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "unrun": "*",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  }
}
