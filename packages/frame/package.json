{
  "name": "@segnavia/frame",
  "version": "0.39.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modstudio/segnavia.git",
    "directory": "packages/frame"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES"
