    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@segnavia/format": "workspace:*",
    "@segnavia/html": "workspace:*",
    "codemirror-lang-mermaid": "0.5.0",
    "mermaid": "12.2.0"
