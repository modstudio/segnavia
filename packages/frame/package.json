{
  "name": "@segnavia/frame",
  "version": "0.11.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modstudio/segnavia.git",
    "directory": "packages/frame"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "./dist/browser/player.js",
  "jsdelivr": "./dist/browser/player.js",
  "exports": {
    ".": {
      "@segnavia/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./svg": {
      "@segnavia/source": "./src/svg.ts",
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg.js"
    },
    "./timeline": {
      "@segnavia/source": "./src/timeline.ts",
      "types": "./dist/timeline.d.ts",
      "default": "./dist/timeline.js"
    },
    "./bridge": {
      "@segnavia/source": "./src/bridge.ts",
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./image-fit": {
      "@segnavia/source": "./src/image-fit.ts",
      "types": "./dist/image-fit.d.ts",
      "default": "./dist/image-fit.js"
    },
    "./stage-layout": {
      "@segnavia/source": "./src/stage-layout.ts",
      "types": "./dist/stage-layout.d.ts",
      "default": "./dist/stage-layout.js"
    },
    "./print-document": {
      "@segnavia/source": "./src/print-document.ts",
      "types": "./dist/print-document.d.ts",
      "default": "./dist/print-document.js"
    },
    "./styled-elements": {
      "@segnavia/source": "./src/styled-elements.ts",
      "types": "./dist/styled-elements.d.ts",
      "default": "./dist/styled-elements.js"
    },
    "./headless-elements": {
      "@segnavia/source": "./src/headless-elements.ts",
      "types": "./dist/headless-elements.d.ts",
      "default": "./dist/headless-elements.js"
    },
    "./player": {
      "@segnavia/source": "./src/player-entry.ts",
      "types": "./dist/player-entry.d.ts",
      "default": "./dist/player-entry.js"
    },
    "./controls": {
      "@segnavia/source": "./src/controls-entry.ts",
      "types": "./dist/controls-entry.d.ts",
      "default": "./dist/controls-entry.js"
    },
    "./authoring": {
      "@segnavia/source": "./src/authoring.ts",
      "types": "./dist/authoring.d.ts",
      "default": "./dist/authoring.js"
    },
    "./icons": {
      "@segnavia/source": "./src/icons.ts",
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./browser/headless": {
      "@segnavia/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/browser/headless.js"
    },
    "./browser/controls": {
      "@segnavia/source": "./src/controls-entry.ts",
      "types": "./dist/controls-entry.d.ts",
      "default": "./dist/browser/controls.js"
    },
    "./browser/player": {
      "@segnavia/source": "./src/player-entry.ts",
      "types": "./dist/player-entry.d.ts",
      "default": "./dist/browser/player.js"
    }
  },
  "dependencies": {
    "@segnavia/format": "workspace:*"
  }
}
