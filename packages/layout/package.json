{
  "name": "@segnavia/layout",
  "description": "Pure page planning and pagination for Segnavia documents.",
  "version": "0.56.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modstudio/segnavia.git",
    "directory": "packages/layout"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "@segnavia/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@segnavia/format": "workspace:*"
  }
}
