{
  "name": "@segnavia/html-editor",
  "description": "Profile-bound visual HTML editing for Segnavia.",
  "version": "0.58.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modstudio/segnavia.git",
    "directory": "packages/html-editor"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./src/html-editor.ts",
    "./dist/html-editor.js"
  ],
  "engines": {
    "node": ">=22"
  },
