      "default": "./dist/html-editor.js"
    }
  },
  "dependencies": {
    "@segnavia/frame": "workspace:*",
    "@segnavia/html": "workspace:*"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0"
  },
  "devDependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "happy-dom": "21.0.4"
  }
}
